{
  "manifest_version": 3,
  "name": "AutoTyper V2 \u2014 Background Tabs",
  "version": "0.3.0",
  "description": "Type supplied text into one selected browser editor while you work in other tabs.",
  "minimum_chrome_version": "118",
  "permissions": [
    "debugger",
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Type into this tab",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "studio.html",
  "commands": {
    "stop-typing": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Stop AutoTyper's browser session"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
